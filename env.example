# Optional — only needed if you want the "Now Playing" widget to work.
# Leave blank/unset to have the dashboard just show "not connected" for that card.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Optional — only needed for the floating AI assistant (bottom-right chat button).
# Free API key from console.groq.com. Leave blank to have it show "not connected".
GROQ_API_KEY=
